# syntax=docker/dockerfile:1.7

# The managed Code image consumes Shikigami as a pinned build input. The final
# runtime still invokes the copied CLI as Code's local subprocess provider; it
# does not start a Shikigami service or define a network protocol.
ARG SHIKIGAMI_IMAGE=ghcr.io/sannrox/shikigami@sha256:91c9ea4f3ef0c59b91cf57a1cc7b3a849c80ea02d984c6a8db71c9736e966a95
FROM --platform=linux/amd64 ${SHIKIGAMI_IMAGE} AS shikigami

FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY vendor/sekai-chisei-sdk ./vendor/sekai-chisei-sdk
RUN npm ci

COPY . .
RUN npm run build:web

FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS runtime

ARG VCS_REF
ARG BUILD_DATE
ARG SOURCE_URL=https://github.com/Sannrox/aldunis-code
ARG SHIKIGAMI_IMAGE
ARG SHIKIGAMI_REVISION=8de00f0d715b1e73573a58f84ccdc157d1f98ca2

RUN test -n "$VCS_REF" \
  && apt-get update \
  && apt-get install --no-install-recommends --yes ca-certificates git \
  && rm -rf /var/lib/apt/lists/* \
  && install -d -m 0700 /var/lib/aldunis-code

LABEL org.opencontainers.image.title="Aldunis Code" \
  org.opencontainers.image.description="Aldunis Code managed workbench runtime" \
  org.opencontainers.image.source="$SOURCE_URL" \
  org.opencontainers.image.revision="$VCS_REF" \
  org.opencontainers.image.created="$BUILD_DATE" \
  com.sannrox.aldunis.shikigami.image="$SHIKIGAMI_IMAGE" \
  com.sannrox.aldunis.shikigami.revision="$SHIKIGAMI_REVISION"

WORKDIR /app
ENV NODE_ENV=production \
  HOME=/var/lib/aldunis-code \
  XDG_STATE_HOME=/var/lib/aldunis-code/state \
  ALDUNIS_CODE_STATE_DIR=/var/lib/aldunis-code

# npm run host executes TypeScript through tsx, so the locked dev dependency
# tree is intentionally retained in the runtime image. The server imports the
# two conversation helpers from src at runtime; copying src also keeps future
# server-side source imports from silently breaking the image.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/src ./src
COPY --from=build /app/contracts ./contracts
COPY --from=build /app/vendor ./vendor
COPY --from=build /app/provider-adapters ./provider-adapters
COPY --from=shikigami /usr/local/bin/shikigami /usr/local/bin/shikigami

CMD ["npm", "run", "host"]
