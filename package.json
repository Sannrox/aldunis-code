{
  "name": "aldunis-code",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first agentic development workbench",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "host": "tsx server/main.ts",
    "wlan": "bash scripts/start-wlan.sh",
    "start": "npm run build && npm run host",
    "test": "tsx --test server/*.test.ts desktop/*.test.ts src/*.test.ts src/lib/**/*.test.ts src/components/ui/*.test.ts src/features/**/*.test.ts",
    "check": "tsc -b --pretty false",
    "verify:desktop-release-tag": "tsx scripts/verify-desktop-release-tag.ts",
    "build:web": "tsc -b && vite build",
    "build:desktop-main": "esbuild desktop/main.ts --bundle --platform=node --format=esm --external:electron --external:proper-lockfile --external:@grpc/grpc-js --external:@grpc/proto-loader --external:@iarna/toml --outfile=dist-electron/main.js && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs && esbuild server/shikigami-permission-hook.mjs --bundle --platform=node --format=esm --outfile=dist-electron/shikigami-permission-hook.mjs && esbuild server/browser-mcp.mjs --bundle --platform=node --format=esm --outfile=dist-electron/browser-mcp.mjs",
    "build": "npm run build:web && npm run build:desktop-main",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@base-ui/react": "^1.6.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@vitejs/plugin-react": "4.3.4",
    "proper-lockfile": "^4.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.10.7",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.aldunis.code",
    "productName": "Aldunis Code",
    "icon": "public/aldunis-mark.png",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "contracts/**/*",
      "provider-adapters/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Aldunis Code",
        "schemes": [
          "aldunis-code"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
