{
  "name": "aldunis-code",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first agentic development workbench",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "host": "tsx server/main.ts",
    "start": "npm run build && npm run host",
    "test": "tsx --test server/*.test.ts desktop/*.test.ts src/*.test.ts src/components/ui/*.test.ts src/features/**/*.test.ts",
    "check": "tsc -b --pretty false",
    "build:web": "tsc -b && vite build",
    "build:desktop-main": "esbuild desktop/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist-electron/main.js && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "npm run build:web && npm run build:desktop-main",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@vitejs/plugin-react": "4.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "tsx": "4.20.3",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.aldunis.code",
    "productName": "Aldunis Code",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Aldunis Code",
        "schemes": [
          "aldunis-code"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
